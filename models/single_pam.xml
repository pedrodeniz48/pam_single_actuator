<mujoco model="single_pam">

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>

        <geom
            name="floor"
            type="plane"
            size="2 2 0.1"
        />

        <!-- fixed anchor -->
        <body name="support" pos="0 0 1.4">

            <geom
                type="box"
                size="0.12 0.12 0.03"
            />

            <site
                name="pam_origin"
                pos="0 0 -0.03"
                size="0.015"
            />

        </body>

        <!-- moving body -->
        <body name="load" pos="0 0 0.7">

            <joint
                name="slider"
                type="slide"
                axis="0 0 1"
                limited="true"
                range="0 0.6"
                damping="0.2"
            />

            <geom
                type="box"
                size="0.07 0.07 0.07"
                mass="1.0"
            />

            <site
                name="pam_insertion"
                pos="0 0 0.07"
                size="0.015"
            />

        </body>

    </worldbody>

    <tendon>

        <spatial name="pam_tendon">
            <site site="pam_origin"/>
            <site site="pam_insertion"/>
        </spatial>

    </tendon>

    <sensor>

        <jointpos
            name="position"
            joint="slider"
        />

        <jointvel
            name="velocity"
            joint="slider"
        />

        <tendonpos
            name="pam_length"
            tendon="pam_tendon"
        />

        <tendonvel
            name="pam_velocity"
            tendon="pam_tendon"
        />

    </sensor>

</mujoco>
